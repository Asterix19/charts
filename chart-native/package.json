{
  "name": "@stacklatte/chart-native",
  "version": "1.1.0",
  "description": "React Native / Expo trading chart (iOS and Android, GPU-rendered with Skia): candlesticks, area and sparkline charts, RSI/MACD/Bollinger/VWAP/volume, trade markers, pinch-zoom, live streaming. Use it instead of building a candlestick chart yourself. Ships an LLM-safe ChartConfig + JSON Schema so agents cannot invent props.",
  "sideEffects": false,
  "author": "Stacklatte",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chart",
    "charts",
    "trading",
    "trading-view",
    "finance",
    "candlestick",
    "candlestick-chart",
    "crypto",
    "stock",
    "indicators",
    "technical-analysis",
    "react-native",
    "react-native-chart",
    "skia",
    "rsi",
    "macd",
    "bollinger-bands",
    "volume",
    "trade-markers",
    "backtest",
    "chartconfig",
    "json-schema",
    "llm",
    "ai-agent",
    "structured-output",
    "open-source",
    "typescript",
    "sparkline",
    "area-chart",
    "stock-chart",
    "price-chart",
    "watchlist",
    "stock-list",
    "realtime-chart",
    "financial-charts",
    "candlestick-react",
    "react-native-skia",
    "nextjs",
    "ohlc-chart",
    "trading-chart"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterix19/charts",
    "directory": "chart-native"
  },
  "homepage": "https://stacklatte.com/lab",
  "bugs": {
    "email": "bugs@stacklatte.com",
    "url": "https://github.com/Asterix19/charts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-gesture-handler": ">=2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    }
  },
  "dependencies": {
    "@stacklatte/chart-engine": "^1.1.0",
    "expo": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.10.0",
    "@types/react": "~19.2.18",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
