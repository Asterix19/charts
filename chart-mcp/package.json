{
  "name": "@stacklatte/chart-mcp",
  "version": "1.0.0",
  "description": "MCP server for Stacklatte Charts: let Claude Code, Cursor and other AI assistants list chart capabilities, generate exact code / ChartConfig / prompts for React, Angular, React Native and TypeScript, validate a ChartConfig and read the docs.",
  "license": "MIT",
  "author": "Rasmus Lagoni",
  "type": "module",
  "bin": {
    "stacklatte-charts-mcp": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "charts",
    "trading",
    "candlestick",
    "sparkline",
    "react",
    "angular",
    "react-native",
    "llm",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterix19/charts.git",
    "directory": "chart-mcp"
  },
  "bugs": {
    "email": "bugs@stacklatte.com",
    "url": "https://github.com/Asterix19/charts/issues"
  },
  "homepage": "https://stacklatte.com/lab",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-docs.mjs && tsup",
    "pretest": "node scripts/build-docs.mjs",
    "prelint": "node scripts/build-docs.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@stacklatte/chart-engine": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
