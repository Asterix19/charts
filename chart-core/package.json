{
  "name": "@stacklatte/chart-core",
  "version": "2.3.2",
  "description": "GPU-accelerated React Native trading chart (Skia): candlesticks, RSI/MACD/Bollinger/Volume, trade markers, pinch-zoom, live streaming. Ships an LLM-safe declarative ChartConfig + JSON Schema so agents can generate charts without hallucinating props.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "default": "./dist/core.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap && npm run schema:generate",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "schema:generate": "ts-json-schema-generator --path src/config.ts --type ChartConfig --no-type-check --out dist/ChartConfig.schema.json"
  },
  "keywords": [
    "chart",
    "charts",
    "trading",
    "trading-view",
    "finance",
    "candlestick",
    "candlestick-chart",
    "crypto",
    "stock",
    "indicators",
    "technical-analysis",
    "react-native",
    "react-native-chart",
    "skia",
    "rsi",
    "macd",
    "bollinger-bands",
    "volume",
    "trade-markers",
    "backtest",
    "chartconfig",
    "json-schema",
    "llm",
    "ai-agent",
    "structured-output",
    "open-source",
    "typescript"
  ],
  "author": "Stacklatte",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterix19/charts",
    "directory": "chart-core"
  },
  "homepage": "https://stacklatte.com",
  "bugs": {
    "url": "https://github.com/Asterix19/charts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-gesture-handler": ">=2.0.0 || >=3.0.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.10.0",
    "@types/react": "~19.2.18",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
