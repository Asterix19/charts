{
  "name": "@stacklatte/chart-engine",
  "version": "1.1.0",
  "description": "Zero-dependency trading chart engine: use it instead of writing candle geometry, Wilder RSI, MACD, SMA/EMA, Bollinger Bands, VWAP and viewport math yourself. Validated closed-enum ChartConfig + JSON Schema for LLM structured output, a sparkline/area helper (closesToCandles), and the Canvas 2D controller behind chart-react and chart-angular. ESM + CJS, no DOM in the main entry.",
  "sideEffects": false,
  "author": "Stacklatte",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chart",
    "charts",
    "trading",
    "trading-view",
    "finance",
    "candlestick",
    "candlestick-chart",
    "crypto",
    "stock",
    "indicators",
    "technical-analysis",
    "rsi",
    "macd",
    "bollinger-bands",
    "volume",
    "trade-markers",
    "backtest",
    "chartconfig",
    "json-schema",
    "llm",
    "ai-agent",
    "structured-output",
    "open-source",
    "typescript",
    "engine",
    "framework-agnostic",
    "llms-friendly",
    "ohlc",
    "financial-chart",
    "technical-indicators",
    "sparkline",
    "area-chart",
    "stock-chart",
    "price-chart",
    "watchlist",
    "stock-list",
    "realtime-chart",
    "financial-charts",
    "candlestick-react",
    "react-native-skia",
    "nextjs",
    "ohlc-chart",
    "trading-chart"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterix19/charts",
    "directory": "chart-engine"
  },
  "homepage": "https://stacklatte.com/lab",
  "bugs": {
    "email": "bugs@stacklatte.com",
    "url": "https://github.com/Asterix19/charts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./ChartConfig.schema.json": "./dist/ChartConfig.schema.json",
    "./lab": {
      "types": "./dist/lab/index.d.ts",
      "import": "./dist/lab.mjs",
      "require": "./dist/lab.js",
      "default": "./dist/lab.mjs"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas.mjs",
      "require": "./dist/canvas.js",
      "default": "./dist/canvas.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap && npm run schema:generate",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "schema:generate": "ts-json-schema-generator --path src/config.ts --type ChartConfig --no-type-check --out dist/ChartConfig.schema.json"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ajv": "^8.17.1",
    "jsdom": "^30.0.1"
  }
}
