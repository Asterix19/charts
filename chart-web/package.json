{
  "name": "@stacklatte/chart-web",
  "version": "1.4.0",
  "description": "[Renamed] React / Next.js trading chart. This package is now a thin re-export of @stacklatte/chart-react \u2014 install that one directly for new code. Existing installs keep working unchanged.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm run build",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "chart",
    "charts",
    "trading",
    "trading-view",
    "finance",
    "candlestick",
    "candlestick-chart",
    "crypto",
    "stock",
    "indicators",
    "technical-analysis",
    "canvas",
    "canvas2d",
    "react",
    "react-chart",
    "rsi",
    "macd",
    "bollinger-bands",
    "volume",
    "trade-markers",
    "backtest",
    "chartconfig",
    "json-schema",
    "llm",
    "ai-agent",
    "structured-output",
    "open-source",
    "typescript",
    "llms-friendly",
    "ohlc",
    "financial-chart",
    "technical-indicators"
  ],
  "author": "Stacklatte",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterix19/charts",
    "directory": "chart-web"
  },
  "homepage": "https://stacklatte.com",
  "bugs": {
    "url": "https://github.com/Asterix19/charts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@stacklatte/chart-react": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
