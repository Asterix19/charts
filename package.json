{
  "name": "stacklatte-charts-monorepo",
  "private": true,
  "workspaces": [
    "chart-engine",
    "chart-native",
    "chart-react",
    "chart-angular",
    "compat",
    "examples/shared",
    "examples/engine-demo",
    "examples/demo",
    "examples/react-demo",
    "examples/angular-demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "demo:react": "npm run dev --workspace=react-demo",
    "demo:native": "npm run start --workspace=demo",
    "demo:ios": "npm run ios --workspace=demo",
    "demo:android": "npm run android --workspace=demo",
    "test:e2e": "npm run build -w @stacklatte/chart-engine -w @stacklatte/chart-react -w @stacklatte/chart-angular && playwright test",
    "test:pack": "npm run build && node scripts/smoke-pack.mjs",
    "test:native": "maestro test e2e-native/flows --test-output-dir e2e-native/screenshots && node e2e-native/compare-screenshots.mjs",
    "demo:angular": "npm run dev --workspace=angular-demo",
    "check:generated": "tsx e2e-native/generate-flows.mjs --check && node scripts/generate-api-docs.mjs --check && node scripts/generate-llms-full.mjs --check",
    "test:contracts": "npm run build -w @stacklatte/chart-engine -w @stacklatte/chart-native -w @stacklatte/chart-react -w @stacklatte/chart-angular && npm test -w @stacklatte/chart-contracts",
    "docs:generate": "npm run build && node scripts/generate-api-docs.mjs && node scripts/generate-llms-full.mjs",
    "test:native:compat": "node e2e-native/compare-chart-core.mjs",
    "docs:screenshots": "node scripts/capture-screenshots.mjs",
    "qa": "tsx scripts/qa-record.mjs",
    "demo:all": "tsx scripts/demo-all.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.3",
    "react-native-worklets": "0.11.2",
    "@shopify/react-native-skia": "2.10.0",
    "eslint-config-expo": {
      "typescript": "6.0.3"
    },
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
