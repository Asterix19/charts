{
  "name": "stacklatte-charts-monorepo",
  "private": true,
  "workspaces": [
    "chart-engine",
    "chart-canvas",
    "chart-native",
    "chart-core",
    "chart-web",
    "chart-angular",
    "compat",
    "examples/shared",
    "examples/engine-demo",
    "examples/demo",
    "examples/web-demo",
    "examples/canvas-demo",
    "examples/angular-demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "demo:web": "npm run dev --workspace=web-demo",
    "demo:native": "npm run start --workspace=demo",
    "demo:ios": "npm run ios --workspace=demo",
    "demo:android": "npm run android --workspace=demo",
    "test:e2e": "npm run build -w @stacklatte/chart-engine -w @stacklatte/chart-canvas -w @stacklatte/chart-web -w @stacklatte/chart-angular && playwright test",
    "test:pack": "npm run build && node scripts/smoke-pack.mjs",
    "test:native": "maestro test e2e-native/flows --test-output-dir e2e-native/screenshots && node e2e-native/compare-screenshots.mjs",
    "demo:angular": "npm run dev --workspace=angular-demo",
    "demo:canvas": "npm run dev --workspace=canvas-demo",
    "check:generated": "tsx e2e-native/generate-flows.mjs --check",
    "test:contracts": "npm run build -w @stacklatte/chart-engine -w @stacklatte/chart-canvas -w @stacklatte/chart-native -w @stacklatte/chart-web -w @stacklatte/chart-core -w @stacklatte/chart-angular && npm test -w @stacklatte/chart-contracts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.3",
    "react-native-worklets": "0.11.2",
    "@shopify/react-native-skia": "2.10.0",
    "eslint-config-expo": {
      "typescript": "6.0.3"
    },
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  }
}
